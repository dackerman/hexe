// A column of sand falls onto bedrock and slumps into a pile.
.{
    .name = "sand_pile",
    .description = "1200 sand cells dropped as a 20x60 column form a pile on the floor; nothing is lost and the pile spreads wider than the column.",
    .ticks = 600,
    .fills = .{
        .{ .rect = .{ .x = 0, .y = 248, .w = 256, .h = 8 }, .material = "bedrock" },
        .{ .rect = .{ .x = 118, .y = 40, .w = 20, .h = 60 }, .material = "sand" },
    },
    .assertions = .{
        .{ .count = .{ .material = "sand", .min = 1200, .max = 1200 }, .label = "sand is conserved" },
        .{ .none = .{ .material = "sand", .rect = .{ .x = 0, .y = 0, .w = 256, .h = 200 } }, .label = "everything has landed" },
        .{ .at = .{ .x = 128, .y = 247, .material = "sand" }, .label = "pile sits on the floor" },
        .{ .count = .{ .material = "sand", .rect = .{ .x = 0, .y = 200, .w = 118, .h = 48 }, .min = 50 }, .label = "slid left of the column" },
        .{ .count = .{ .material = "sand", .rect = .{ .x = 138, .y = 200, .w = 118, .h = 48 }, .min = 50 }, .label = "slid right of the column" },
    },
}
