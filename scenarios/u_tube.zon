// docs/04-fluids.md scenario 1: water poured into a U-tube equalizes.
// The spec's 2 s is not met: 160-px arms at 196 px/s^2 oscillate with a
// period of about 4 s, and damping that equalizes them in 2 s kills
// dam-break waves (docs/decisions/87-liquid-scenarios.md). Asserted within
// 12 s of the pour instead (docs/decisions/116-integrate-liquid.md).
.{
    .name = "u_tube",
    .description = "Water poured into the left arm of a stone U-tube for 60 ticks; 12 s (720 ticks) after the pour stops both arms hold the same level.",
    .requires = .{.flip},
    .ticks = 780,
    .fills = .{
        .{ .rect = .{ .x = 40, .y = 40, .w = 176, .h = 200 }, .material = "stone" },
        .{ .rect = .{ .x = 60, .y = 40, .w = 20, .h = 180 }, .material = "air" },
        .{ .rect = .{ .x = 176, .y = 40, .w = 20, .h = 180 }, .material = "air" },
        .{ .rect = .{ .x = 60, .y = 200, .w = 136, .h = 20 }, .material = "air" },
    },
    .commands = .{
        // Up to 80 cells per tick for 61 ticks (only into air, ~3300 land):
        // 2720 fill the channel, the rest splits between the arms.
        .{ .tick = 0, .every = 1, .until = 60, .fill = .{ .rect = .{ .x = 60, .y = 42, .w = 20, .h = 4 }, .material = "water", .only = "air" } },
    },
    .assertions = .{
        .{ .count = .{ .material = "water", .rect = .{ .x = 60, .y = 40, .w = 20, .h = 160 }, .min = 160, .max = 600 }, .label = "left arm level" },
        .{ .count = .{ .material = "water", .rect = .{ .x = 176, .y = 40, .w = 20, .h = 160 }, .min = 160, .max = 600 }, .label = "right arm level" },
        .{ .none = .{ .material = "water", .rect = .{ .x = 60, .y = 40, .w = 20, .h = 96 } }, .label = "left arm not overfull" },
        .{ .none = .{ .material = "water", .rect = .{ .x = 176, .y = 40, .w = 20, .h = 96 } }, .label = "right arm not overfull" },
    },
}
