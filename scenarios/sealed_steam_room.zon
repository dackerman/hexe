// docs/04-fluids.md scenario 3: lava and water meet in a sealed 64x64
// room; pressure rises; a 1-health wood wall on one side fails before the
// stone on the other.
.{
    .name = "sealed_steam_room",
    .description = "Sealed 64x64 room (stone shell, left wall wood at health 1). Lava and water inside make steam; air pressure climbs until the wood wall gives while the stone wall stands.",
    .requires = .{.air_field},
    .ticks = 1200,
    .fills = .{
        .{ .rect = .{ .x = 92, .y = 92, .w = 72, .h = 72 }, .material = "stone" },
        .{ .rect = .{ .x = 96, .y = 96, .w = 64, .h = 64 }, .material = "air" },
        .{ .rect = .{ .x = 92, .y = 96, .w = 4, .h = 64 }, .material = "wood", .state = 1 },
        .{ .rect = .{ .x = 96, .y = 144, .w = 32, .h = 16 }, .material = "lava" },
        .{ .rect = .{ .x = 128, .y = 144, .w = 32, .h = 16 }, .material = "water" },
    },
    .assertions = .{
        .{ .tick = 120, .count = .{ .material = "steam", .rect = .{ .x = 96, .y = 96, .w = 64, .h = 64 }, .min = 20 }, .label = "steam in the room" },
        .{ .tick = 240, .pressure = .{ .x = 128, .y = 110, .min = 1.02 }, .label = "pressure rose" },
        .{ .none = .{ .material = "wood", .rect = .{ .x = 92, .y = 96, .w = 4, .h = 64 } }, .label = "wood wall failed" },
        .{ .count = .{ .material = "stone", .rect = .{ .x = 160, .y = 96, .w = 4, .h = 64 }, .min = 240 }, .label = "stone wall stands" },
    },
}
