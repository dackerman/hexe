// Hot cellular liquid. Emits heat and light; cools to stone below 700 C.
.{
    .name = "lava",
    .id = 17,
    .phase = .liquid,
    .density = 270,
    .dispersion = 1,
    .temperature = 1100,
    .conductivity = 60,
    .emits_heat = 40,
    .freeze = .{ .at = 700, .to = "stone" },
    .impact = .splash,
    .blast_threshold = 40,
    .blast_response = .fly,
    .drag = 60,
    .emissive = 200,
    .glow = .{ .from = 700, .to = 1300 },
    .on_contact = .{ .burn = 40, .ignite = true },
    .ramp = .{ 0x8f1d0a, 0xc23410, 0xe8521a, 0xff7a24, 0xffa63a, 0xffd25a },
}
