// Byproduct of stone. Melts back to lava like stone.
.{
    .name = "gravel",
    .id = 14,
    .phase = .powder,
    .density = 160,
    .slide = 120,
    .conductivity = 30,
    .melt = .{ .at = 1300, .to = "lava" },
    .impact = .spray,
    .blast_threshold = 40,
    .blast_response = .fly,
    .drag = 30,
    .ramp = .{ 0x6a6460, 0x7d7670, 0x5a5450, 0x8e8780, 0x4c4744 },
}
