// Dissolves stone, concrete, steel, wood, flesh and bone; becomes acid gas doing so.
.{
    .name = "acid",
    .id = 1,
    .phase = .liquid,
    .density = 110,
    .dispersion = 4,
    .conductivity = 40,
    .impact = .splash,
    .blast_threshold = 10,
    .blast_response = .fly,
    .drag = 180,
    .translucent = true,
    .on_contact = .{ .corrode = 15, .strip_armor = true },
    .ramp = .{ 0x3d8b1f, 0x5cb82a, 0x7fd93a, 0xa6f05a, 0x4fa324 },
    .reactions = .{
        .{ .with = "stone", .self = "acid_gas", .other = "air", .chance = 20 },
        .{ .with = "concrete", .self = "acid_gas", .other = "air", .chance = 24 },
        .{ .with = "steel", .self = "acid_gas", .other = "air", .chance = 8 },
        .{ .with = "wood", .self = "acid_gas", .other = "air", .chance = 30 },
        .{ .with = "flesh", .self = "acid_gas", .other = "air", .chance = 40 },
        .{ .with = "bone", .self = "acid_gas", .other = "air", .chance = 4 },
    },
}
