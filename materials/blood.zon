// Byproduct of entities. Stains; dries to blood_crust.
.{
    .name = "blood",
    .id = 5,
    .phase = .liquid,
    .density = 105,
    .dispersion = 4,
    .lifetime = 1800,
    .decays_to = "blood_crust",
    .temperature = 37,
    .conductivity = 40,
    .impact = .splash,
    .blast_threshold = 10,
    .blast_response = .fly,
    .drag = 150,
    .on_contact = .{ .bloody = true },
    .ramp = .{ 0x5c0a0e, 0x7a1016, 0x8f1820, 0x6b0d12 },
}
