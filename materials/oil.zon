// Floats on water; burns to smoke; stains entities.
.{
    .name = "oil",
    .id = 22,
    .phase = .liquid,
    .density = 80,
    .dispersion = 4,
    .conductivity = 20,
    .flammable = .{ .ignite_at = 250, .burn_ticks = 400, .to = "smoke", .smoke = "smoke", .heat = 24 },
    .impact = .splash,
    .blast_threshold = 10,
    .blast_response = .fly,
    .drag = 150,
    .on_contact = .{ .oily = true, .slippery = true },
    .ramp = .{ 0x1a1410, 0x241c16, 0x2e241c, 0x14100c },
}
