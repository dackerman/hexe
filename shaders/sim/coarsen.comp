#version 460
// Obstacle coarsening (docs/04-fluids.md "Shared: obstacle coarsening"):
// one thread per 2x2 pixel block, once per tick after movement, over the
// whole window. Writes per block the number of solid pixels (static phase
// or body-owned, 0-4) to SOLID_COARSE, liquid pixels to LIQUID_COARSE, and
// the mean temperature byte to a private image for the air field's
// buoyancy. Reads cells only; never changes the grid.
#include "common.glsl"
#include "sim/air/air_api.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    uint temp_slot; // r8ui mean temperature byte per block
} pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 p = c * 2;
    uint solid = 0u;
    uint liquid = 0u;
    uint tsum = 0u;
    for (int k = 0; k < 4; k++) {
        uint cl = imageLoad(CELLS, p + ivec2(k & 1, k >> 1)).x;
        uint phase = mat_phase(MATERIALS[cell_material(cl)].move);
        if (phase == PHASE_STATIC || cell_has(cl, CELL_FLAG_BODY)) {
            solid++;
        } else if (phase == PHASE_LIQUID) {
            liquid++;
        }
        tsum += cell_temperature(cl);
    }
    imageStore(SOLID_COARSE, c, uvec4(solid));
    imageStore(LIQUID_COARSE, c, uvec4(liquid));
    imageStore(g_u8_images[pc.temp_slot], c, uvec4((tsum + 2u) >> 2));
}
