#version 460
// Apply one command (fill, ignite, heat or charge over a circle or rect)
// over its bounding box. The CPU
// records one dispatch per command, in list order, with a barrier between
// them, and aligns the box origin to 16 so each workgroup lies inside one
// activity tile. Changed tiles are marked active (with neighbors).
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    ivec2 origin; // unwrapped world pixel of the box's top-left, multiple of 16
    uvec2 size; // box size in pixels
    uint index; // command index in COMMANDS
    uint mark_tiles; // nonzero: mark changed tiles in TILE_MARKS
} pc;

shared bool s_changed;

// The cell after command `c` (spawn hash `h`) acts on `old`.
uint apply_command(Command c, uint old, uint h) {
    uint action = c.kind >> CMD_ACTION_SHIFT;
    uint om = cell_material(old);
    if (action == CMD_ACTION_IGNITE) {
        if ((MATERIALS[om].flags & MATERIAL_FLAG_FLAMMABLE) == 0u || cell_has(old, CELL_FLAG_BURNING)) return old;
        return cell_ignite(old, om);
    }
    if (action == CMD_ACTION_HEAT) return cell_with_temperature(old, (c.flags >> CMD_TEMP_SHIFT) & 0xffu);
    if (action == CMD_ACTION_CHARGE) {
        if (!mat_conductive(om) || cell_charge(old) != 0u) return old;
        return cell_with_state(old, (cell_state(old) & CONDUCTIVE_STATE_MASK) | (CHARGE_HEAD << CHARGE_SHIFT));
    }
    uint material = c.material & 0xffu;
    if ((c.flags & CMD_FLAG_ONLY_AIR) != 0u && om != MATERIAL_AIR) return old;
    if ((c.flags & CMD_FLAG_ONLY_MATERIAL) != 0u && om != ((c.material >> CMD_ONLY_SHIFT) & 0xffu)) return old;
    uint cell = spawn_cell(material, h >> 28);
    if ((c.flags & CMD_FLAG_SET_TEMP) != 0u) cell = cell_with_temperature(cell, (c.flags >> CMD_TEMP_SHIFT) & 0xffu);
    if ((c.flags & CMD_FLAG_SET_STATE) != 0u) cell = cell_with_state(cell, c.flags >> CMD_STATE_SHIFT);
    return cell;
}

bool inside_shape(Command c, ivec2 p) {
    uint shape = c.kind & CMD_SHAPE_MASK;
    if (shape == CMD_FILL_CIRCLE) {
        ivec2 d = p - ivec2(c.x0, c.y0);
        return d.x * d.x + d.y * d.y <= c.x1 * c.x1;
    }
    if (shape == CMD_FILL_RECT) {
        return all(greaterThanEqual(p, ivec2(c.x0, c.y0))) && all(lessThan(p, ivec2(c.x1, c.y1)));
    }
    return false;
}

void main() {
    if (gl_LocalInvocationIndex == 0u) s_changed = false;
    barrier();

    Command c = COMMANDS[pc.index];
    ivec2 p = pc.origin + ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(gl_GlobalInvocationID.xy, pc.size)) && inside_shape(c, p)) {
        ivec2 w = wrap_coord(p);
        uint old = imageLoad(CELLS, w).x;
        uint h = hash_salt(uint(w.x), uint(w.y), c.seed, SALT_SPAWN_VARIANT);
        uint coverage = (c.flags >> CMD_COVERAGE_SHIFT) & 0xffu;
        bool hit = coverage == 0u || (h & 0xffu) < coverage;
        uint cell = apply_command(c, old, h);
        if (hit && cell != old) {
            imageStore(CELLS, w, uvec4(cell, 0u, 0u, 0u));
            s_changed = true;
        }
    }

    barrier();
    if (gl_LocalInvocationIndex == 0u && s_changed && pc.mark_tiles != 0u) {
        ivec2 corner = wrap_coord(pc.origin + ivec2(gl_WorkGroupID.xy * 16u));
        mark_tile_and_neighbors(uvec2(corner) >> TILE_SHIFT);
    }
}
