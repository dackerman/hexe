#version 460
// Apply one command over its bounding box: a shape (circle, rect, line) with
// an action (fill, ignite, heat, charge), or an eject. The CPU records one
// dispatch per command, in list order, with a barrier between them, and
// aligns the box origin to 16 so each workgroup lies inside one activity
// tile. Changed tiles are marked active (with neighbors). Spray runs in
// shaders/sim/particles/spray.comp, inject_pressure in the air field.
// Mirrored by src/sim/reference/grid.zig (eject: the cell edits, assuming
// the particle budget is not exhausted).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "common.glsl"
#include "sim/events.glsl"
#include "sim/particles/particles.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    ivec2 origin; // unwrapped world pixel of the box's top-left, multiple of 16
    uvec2 size; // box size in pixels
    uint index; // command index in COMMANDS
    uint mark_tiles; // nonzero: mark changed tiles in TILE_MARKS
} pc;

shared bool s_changed;

#define SALT_EJECT 0xe1ecu

// Distance from p to segment a-b at most r; exact integer test
// (commands.zig insideCapsule).
bool inside_capsule(ivec2 a, ivec2 b, int r, ivec2 p) {
    ivec2 u = b - a;
    ivec2 w = p - a;
    int len2 = u.x * u.x + u.y * u.y;
    int dot_uw = w.x * u.x + w.y * u.y;
    if (dot_uw <= 0) return w.x * w.x + w.y * w.y <= r * r;
    if (dot_uw >= len2) {
        ivec2 q = p - b;
        return q.x * q.x + q.y * q.y <= r * r;
    }
    int64_t cross = int64_t(u.x) * int64_t(w.y) - int64_t(u.y) * int64_t(w.x);
    return cross * cross <= int64_t(r) * int64_t(r) * int64_t(len2);
}

bool inside_shape(Command c, ivec2 p) {
    uint shape = c.kind & CMD_SHAPE_MASK;
    if (shape == CMD_FILL_CIRCLE || shape == CMD_EJECT) {
        ivec2 d = p - ivec2(c.x0, c.y0);
        return d.x * d.x + d.y * d.y <= c.x1 * c.x1;
    }
    if (shape == CMD_FILL_RECT) {
        return all(greaterThanEqual(p, ivec2(c.x0, c.y0))) && all(lessThan(p, ivec2(c.x1, c.y1)));
    }
    if (shape == CMD_FILL_LINE) {
        return inside_capsule(ivec2(c.x0, c.y0), ivec2(c.x1, c.y1), int(c.material >> CMD_LINE_RADIUS_SHIFT), p);
    }
    return false;
}

// The cell after shape command `c` (spawn hash `h`) acts on `old`.
uint apply_command(Command c, uint old, uint h) {
    uint action = (c.kind >> CMD_ACTION_SHIFT) & 0xffu;
    uint om = cell_material(old);
    if (action == CMD_ACTION_IGNITE) {
        if ((MATERIALS[om].flags & MATERIAL_FLAG_FLAMMABLE) == 0u || cell_has(old, CELL_FLAG_BURNING)) return old;
        return cell_ignite(old, om);
    }
    if (action == CMD_ACTION_HEAT) return cell_with_temperature(old, (c.flags >> CMD_TEMP_SHIFT) & 0xffu);
    if (action == CMD_ACTION_CHARGE) {
        if (!mat_conductive(om) || cell_charge(old) != 0u) return old;
        return cell_with_state(old, (cell_state(old) & CONDUCTIVE_STATE_MASK) | (CHARGE_HEAD << CHARGE_SHIFT));
    }
    uint material = c.material & 0xffu;
    if ((c.flags & CMD_FLAG_ONLY_AIR) != 0u && om != MATERIAL_AIR) return old;
    if ((c.flags & CMD_FLAG_ONLY_MATERIAL) != 0u && om != ((c.material >> CMD_ONLY_SHIFT) & 0xffu)) return old;
    uint cell = spawn_cell(material, h >> 28);
    if ((c.flags & CMD_FLAG_SET_TEMP) != 0u) cell = cell_with_temperature(cell, (c.flags >> CMD_TEMP_SHIFT) & 0xffu);
    if ((c.flags & CMD_FLAG_SET_STATE) != 0u) cell = cell_with_state(cell, c.flags >> CMD_STATE_SHIFT);
    return cell;
}

// Radial launch velocity for an ejected cell: away from the center, biased
// upward, with some hashed spread. Float, but it only steers particles; which
// cells fly is decided in integers (mirrored by the reference).
vec2 eject_velocity(ivec2 d, int speed, uint h) {
    float a = (d.x == 0 && d.y == 0) ? -1.5707963 : atan(float(d.y), float(d.x));
    a += (float((h >> 8) & 0xffu) / 255.0 - 0.5) * 0.9; // +-26 degrees
    float s = float(speed) * (0.45 + 0.75 * float(h & 0xffu) / 255.0);
    vec2 v = vec2(cos(a), sin(a)) * s;
    v.y -= (0.15 + 0.25 * float((h >> 16) & 0xffu) / 255.0) * float(speed);
    return v;
}

// One ejected cell. Speed falls off quadratically from y1 at the center to 0
// at the rim. Loose cells (powder, liquid, gas) at or above EJECT_MIN_SPEED
// fly as particles; solids with health lose speed >> EJECT_DAMAGE_SHIFT and,
// at zero, fly as their rubble (their own material when they have none).
// Body-owned and particle-backed cells are left alone.
bool apply_eject(Command c, ivec2 p, ivec2 w, uint old) {
    uint m = cell_material(old);
    if (m == MATERIAL_AIR || (old & (CELL_FLAG_BODY | CELL_FLAG_PARTICLE)) != 0u) return false;
    ivec2 d = p - ivec2(c.x0, c.y0);
    int r2 = c.x1 * c.x1;
    int d2 = d.x * d.x + d.y * d.y;
    int f = ((r2 - d2) << 8) / max(r2, 1);
    int speed = (c.y1 * f) >> 8;
    uint h = hash_salt(uint(w.x), uint(w.y), c.seed, SALT_EJECT);
    vec2 vel = eject_velocity(d, speed, h);
    if (mat_phase(MATERIALS[m].move) == PHASE_STATIC) {
        if (MATERIALS[m].health == 0u) return false;
        uint damage = uint(speed) >> EJECT_DAMAGE_SHIFT;
        if (damage == 0u) return false;
        uint hp = cell_state(old);
        if (damage < hp) {
            imageStore(CELLS, w, uvec4(cell_with_state(old, hp - damage), 0u, 0u, 0u));
            return true;
        }
        uint rubble = MATERIALS[m].rubble;
        if (eject_observed(w, old, vel, rubble)) return true;
        // The particle was refused: the rubble stays in place.
        imageStore(CELLS, w, uvec4(spawn_cell(rubble, cell_variant(old)), 0u, 0u, 0u));
        return true;
    }
    if (uint(speed) < EJECT_MIN_SPEED) return false;
    return eject_observed(w, old, vel, m);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) s_changed = false;
    barrier();

    Command c = COMMANDS[pc.index];
    ivec2 p = pc.origin + ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(gl_GlobalInvocationID.xy, pc.size)) && inside_shape(c, p)) {
        ivec2 w = wrap_coord(p);
        uint old = imageLoad(CELLS, w).x;
        bool changed = false;
        if ((c.kind & CMD_SHAPE_MASK) == CMD_EJECT) {
            changed = apply_eject(c, p, w, old);
            if (p == ivec2(c.x0, c.y0)) emit_event(p, EVENT_EJECT, uint(c.x1));
        } else {
            uint h = hash_salt(uint(w.x), uint(w.y), c.seed, SALT_SPAWN_VARIANT);
            uint coverage = (c.flags >> CMD_COVERAGE_SHIFT) & 0xffu;
            bool hit = coverage == 0u || (h & 0xffu) < coverage;
            uint cell = apply_command(c, old, h);
            if (hit && cell != old) {
                imageStore(CELLS, w, uvec4(cell, 0u, 0u, 0u));
                changed = true;
                // Lighting a material with an ignition event (gunpowder's
                // explode) appends it, like ignition by heat or contact in
                // the reactions pass: decision 141.
                uint om = cell_material(old);
                if (((c.kind >> CMD_ACTION_SHIFT) & 0xffu) == CMD_ACTION_IGNITE && MATERIALS[om].burn_event != 0u) emit_event(w, MATERIALS[om].burn_event, om);
            }
        }
        if (changed) s_changed = true;
    }

    barrier();
    if (gl_LocalInvocationIndex == 0u && s_changed && pc.mark_tiles != 0u) {
        ivec2 corner = wrap_coord(pc.origin + ivec2(gl_WorkGroupID.xy * 16u));
        mark_tile_and_neighbors(uvec2(corner) >> TILE_SHIFT);
    }
}
