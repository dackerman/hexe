#version 460
// Readback: material-id byte plane of each requested region (entity strips),
// into this frame slot's host-visible buffer after the masks. Region r is
// rows of ceil(w / 4) words, 4 material bytes each, little endian, at word
// `offset_words`, followed by a plane of the same shape holding one info
// byte per cell (INFO_* below, src/sim/readback.zig `Mirror.info`; decision
// 120). Workgroup y = region index.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint table_slot;
    uint out_slot;
    uint out_base_words; // first word after the masks
} pc;

struct Region {
    int x;
    int y;
    uint w;
    uint h;
    uint offset_words;
    uint words_per_row;
    uint pad0;
    uint pad1;
};

HEXE_BUFFER(RegionTableBlock, readonly, Region regions[];, g_region_tables);
HEXE_BUFFER(RegionOutBlock, writeonly, uint words[];, g_region_out);

// Info byte bits (mirrored in readback.zig `Info`).
#define INFO_CHARGED 0x1u  // conductive cell with a nonzero charge phase
#define INFO_BURNING 0x2u  // burning flag
#define INFO_BODY 0x4u     // body-owned
#define INFO_PARTICLE 0x8u // particle-backed (awake solver liquid)

uint cell_info(uint c) {
    uint m = cell_material(c);
    uint info = 0u;
    if (mat_conductive(m) && cell_charge(c) != 0u) info |= INFO_CHARGED;
    if (cell_has(c, CELL_FLAG_BURNING)) info |= INFO_BURNING;
    if (cell_has(c, CELL_FLAG_BODY)) info |= INFO_BODY;
    if (cell_has(c, CELL_FLAG_PARTICLE)) info |= INFO_PARTICLE;
    return info;
}

void main() {
    Region r = g_region_tables[pc.table_slot].regions[gl_WorkGroupID.y];
    uint j = gl_GlobalInvocationID.x;
    if (j >= r.words_per_row * r.h) return;
    uint row = j / r.words_per_row;
    uint col = (j % r.words_per_row) * 4u;
    uint word = 0u;
    uint info = 0u;
    for (uint b = 0u; b < 4u; b++) {
        if (col + b < r.w) {
            uint c = load_cell(ivec2(r.x + int(col + b), r.y + int(row)));
            word |= cell_material(c) << (8u * b);
            info |= cell_info(c) << (8u * b);
        }
    }
    uint base = pc.out_base_words + r.offset_words;
    g_region_out[pc.out_slot].words[base + j] = word;
    g_region_out[pc.out_slot].words[base + r.words_per_row * r.h + j] = info;
}
