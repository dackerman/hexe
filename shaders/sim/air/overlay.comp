#version 460
// Debug overlay of the air field (docs/decisions/78-air-overlay.md): one
// RGBA8 texel per lattice cell into SLOT_IMG_DEBUG_OVERLAY, meant to be
// added to the world colors. Red = overpressure, blue = underpressure
// (both |rho - 1| * pressure_gain), green = speed (|v| px/tick *
// speed_gain), walls faint grey, sleeping air tiles darkened.
// Alpha = overall intensity, for compositors that alpha-blend instead.
#include "common.glsl"
#include "sim/air/air_api.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    float pressure_gain;
    float speed_gain;
} pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    vec4 a = imageLoad(AIR_FIELD, c);
    vec3 col;
    if (a.w != 0.0) {
        col = vec3(0.06);
    } else {
        float dp = (a.x - 1.0) * pc.pressure_gain;
        float sp = length(a.yz) * pc.speed_gain;
        col = vec3(max(dp, 0.0), 0.0, max(-dp, 0.0)) + vec3(0.15, 0.9, 0.35) * sp;
        // Velocity direction tint so flows read: hue from the angle, faint.
        if (sp > 0.02) col += 0.25 * min(sp, 1.0) * (0.5 + 0.5 * vec3(cos(atan(a.z, a.y)), 0.0, sin(atan(a.z, a.y))));
    }
    uint t = air_tile_index(uvec2(c) / AIR_TILE);
    bool awake = uint(AIR_TILE_MARKS[AIR_TILE_ACTIVE_OFFSET + t]) != 0u;
    bool edge = any(equal(uvec2(c) & (AIR_TILE - 1u), uvec2(0u)));
    if (awake && edge) col += vec3(0.08, 0.08, 0.0);
    col = clamp(col, 0.0, 1.0);
    imageStore(DEBUG_OVERLAY, c, vec4(col, max(col.r, max(col.g, col.b))));
}
